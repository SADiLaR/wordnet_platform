# Copy this file to .env and fill in your values

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DB_PASSWORD=
DEBUG=True

# Email and error-reporting settings. Keep the console backend enabled for
# local development; configure real SMTP credentials outside the repository.
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=webmaster@localhost
SERVER_EMAIL=root@localhost
EMAIL_SUBJECT_PREFIX="[Django] "
# Format as: Name Surname address@example.com, Name Surname address@example.com
ADMINS=
EMAIL_BACKEND_CONSOLE=True
